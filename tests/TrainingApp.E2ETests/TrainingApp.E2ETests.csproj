<Project Sdk="Microsoft.NET.Sdk">

  <!-- End-to-end tests: the API is built into a Docker image and started in a container (Testcontainers);
       tests talk to it over real HTTP only, exactly like a client would. Requires Docker. -->
  <PropertyGroup>
    <!-- xUnit v3 test projects are executables. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Testcontainers" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <!-- No reference to TrainingApp.Api on purpose: e2e tests know only the HTTP contract, not the code. -->

  <ItemGroup>
    <Using Include="FluentAssertions" />
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
