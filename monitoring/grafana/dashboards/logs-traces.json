{
  "uid": "trainingapp-logs-traces",
  "title": "TrainingApp — Logs & Traces",
  "tags": ["trainingapp"],
  "links": [
    { "type": "dashboards", "tags": ["trainingapp"], "asDropdown": false, "includeVars": false, "keepTime": true, "title": "TrainingApp" }
  ],
  "timezone": "browser",
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "schemaVersion": 39,
  "editable": true,
  "templating": {
    "list": [
      {
        "name": "level",
        "label": "Log level",
        "type": "custom",
        "query": "error,warn,info,debug",
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "search",
        "label": "Log text",
        "type": "textbox",
        "query": "",
        "current": { "text": "", "value": "" }
      },
      {
        "name": "min_duration",
        "label": "Slow trace ≥",
        "type": "custom",
        "query": "1ms,5ms,10ms,50ms,100ms,500ms",
        "current": { "text": "5ms", "value": "5ms" }
      },
      {
        "name": "trace_id",
        "label": "Trace ID",
        "description": "Click a trace ID in the tables to show the trace and its logs at the bottom of the dashboard.",
        "type": "textbox",
        "query": "",
        "current": { "text": "", "value": "" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Log lines by level",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "fillOpacity": 80, "stacking": { "mode": "normal" } } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "error" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] },
          { "matcher": { "id": "byName", "options": "warn" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } }] },
          { "matcher": { "id": "byName", "options": "info" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] },
          { "matcher": { "id": "byName", "options": "debug" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }] }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "queryType": "range",
          "expr": "sum by (detected_level) (count_over_time({service_name=\"TrainingApp.Api\"} | detected_level=~\"$level\" [$__auto]))",
          "legendFormat": "{{detected_level}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Spans per second by name (errors dashed)",
      "description": "Span metrics generated by Tempo from received traces.",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "reqps" },
        "overrides": [
          {
            "matcher": { "id": "byFrameRefID", "options": "B" },
            "properties": [{ "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [10, 10] } }]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (span_name) (rate(traces_spanmetrics_calls_total{service=\"TrainingApp.Api\"}[$__rate_interval]))",
          "legendFormat": "{{span_name}}",
          "exemplar": true
        },
        {
          "refId": "B",
          "expr": "sum by (span_name) (rate(traces_spanmetrics_calls_total{service=\"TrainingApp.Api\", status_code=\"STATUS_CODE_ERROR\"}[$__rate_interval]))",
          "legendFormat": "{{span_name}} · error"
        }
      ]
    },
    {
      "id": 3,
      "type": "table",
      "title": "Recent traces",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 10 },
      "datasource": { "type": "tempo", "uid": "tempo" },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "traceID" },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Show trace and its logs below",
                    "url": "/d/trainingapp-logs-traces?var-trace_id=${__value.raw}&${level:queryparam}&${search:queryparam}&${min_duration:queryparam}&${__url_time_range}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "tempo", "uid": "tempo" },
          "queryType": "traceql",
          "query": "{resource.service.name=\"TrainingApp.Api\"}",
          "tableType": "traces",
          "limit": 50
        }
      ]
    },
    {
      "id": 4,
      "type": "table",
      "title": "Failed or slow traces (≥ $min_duration)",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 10 },
      "datasource": { "type": "tempo", "uid": "tempo" },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "traceID" },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Show trace and its logs below",
                    "url": "/d/trainingapp-logs-traces?var-trace_id=${__value.raw}&${level:queryparam}&${search:queryparam}&${min_duration:queryparam}&${__url_time_range}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "tempo", "uid": "tempo" },
          "queryType": "traceql",
          "query": "{resource.service.name=\"TrainingApp.Api\" && (status = error || span.outcome = \"rejected\" || span.http.response.status_code >= 400)} || {resource.service.name=\"TrainingApp.Api\" && nestedSetParent < 0 && duration >= $min_duration}",
          "tableType": "traces",
          "limit": 50
        }
      ]
    },
    {
      "id": 5,
      "type": "logs",
      "title": "Logs · expand a line and use \"Open trace\" to jump to Tempo",
      "gridPos": { "x": 0, "y": 18, "w": 24, "h": 12 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "queryType": "range",
          "expr": "{service_name=\"TrainingApp.Api\"} | detected_level=~\"$level\" |= \"$search\""
        }
      ]
    },
    {
      "id": 6,
      "type": "row",
      "title": "Selected trace: $trace_id",
      "gridPos": { "x": 0, "y": 30, "w": 24, "h": 1 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 7,
      "type": "traces",
      "title": "Trace · span \"Logs for this span\" opens the matching Loki lines",
      "gridPos": { "x": 0, "y": 31, "w": 24, "h": 14 },
      "datasource": { "type": "tempo", "uid": "tempo" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "tempo", "uid": "tempo" },
          "queryType": "traceql",
          "query": "$trace_id"
        }
      ]
    },
    {
      "id": 8,
      "type": "logs",
      "title": "Logs of the selected trace",
      "gridPos": { "x": 0, "y": 45, "w": 24, "h": 10 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Ascending"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "queryType": "range",
          "expr": "{service_name=\"TrainingApp.Api\"} | trace_id=\"$trace_id\""
        }
      ]
    }
  ]
}
